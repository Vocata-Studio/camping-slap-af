---
import { t } from "../i18n/utils";
import type { Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  /** Show the text label next to the icon (used in menus/footer). */
  labelled?: boolean;
}

const { locale, labelled = false } = Astro.props;
const label = t(locale, "Header", "themeToggle");
---

<button
  type="button"
  class:list={["theme-toggle", labelled && "theme-toggle--labelled"]}
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <svg
    data-theme-icon="sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    data-theme-icon="moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
  {labelled && <span class="theme-toggle__label">{label}</span>}
</button>

<!--
  The toggle is markup-only on purpose. The click/icon-sync logic is bound
  once in Layout.astro at the end of <body>, so the same handler covers every
  [data-theme-toggle] instance (menu + footer) without double-binding.
-->

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-ink);
    background: transparent;
    border: 0;
  }
  .theme-toggle:hover {
    color: var(--color-green);
  }
  .theme-toggle svg {
    display: none;
  }

  /* Labelled variant — used inside the mobile menu and the footer */
  .theme-toggle--labelled {
    width: auto;
    height: auto;
    gap: var(--space-3);
    color: var(--color-muted);
  }
  .theme-toggle--labelled:hover {
    color: var(--color-green);
  }
  .theme-toggle__label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 500;
  }
</style>
