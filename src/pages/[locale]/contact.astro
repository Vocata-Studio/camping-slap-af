---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { contactUi, locales, isValidLocale, t } from "../../i18n/utils";
import type { Locale } from "../../i18n/utils";

const LEAFLET_VERSION = "1.9.4";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isValidLocale(locale)) return Astro.redirect("/da");
const l = locale as Locale;

const heroImage = "/images/overhead-shot.webp";

const phone = t(l, "Contact", "phone");
const email = t(l, "Contact", "email");
const phoneHref = `tel:${phone.replace(/\s+/g, "")}`;
const copyUi = contactUi(l);
const formSuccess = t(l, "Contact", "formSuccess");
const formError = t(l, "Contact", "formError");
---

<Layout title={t(l, "Contact", "title")} locale={l} description={t(l, "Meta", "contactDescription")}>
  <link
    slot="head"
    rel="stylesheet"
    href={`https://unpkg.com/leaflet@${LEAFLET_VERSION}/dist/leaflet.css`}
  />
  <Hero
    image={heroImage}
    imageAlt={t(l, "Contact", "title")}
    title={t(l, "Contact", "title")}
    subtitle={t(l, "Contact", "subtitle")}
    compact
  />

  <!-- Contact info + form -->
  <section class="section">
    <div class="container contact-grid">
      <!-- Info column -->
      <div class="contact-info">
        <h2 class="contact-info__heading">{t(l, "Contact", "infoTitle")}</h2>

        <ul class="contact-info__list">
          <li>
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 7-8 12-8 12s-8-5-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <div class="contact-info__label">{t(l, "Contact", "addressLabel")}</div>
              <div class="contact-info__value">{t(l, "Contact", "address")}</div>
            </div>
          </li>
          <li>
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z" />
              </svg>
            </div>
            <div>
              <div class="contact-info__label">{t(l, "Booking", "phoneLabel")}</div>
              <a
                href={phoneHref}
                class="contact-info__value contact-info__value--link contact-info__copy-trigger"
                data-copy-value={phone}
                data-copy-toast={copyUi.phoneCopied}
                data-copy-mobile-call="true"
              >
                <span>{phone}</span>
                <span class="contact-copy-subtext">{copyUi.copy}</span>
              </a>
            </div>
          </li>
          <li>
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <div>
              <div class="contact-info__label">{t(l, "Booking", "emailLabel")}</div>
              <button
                type="button"
                class="contact-info__value contact-info__value--link contact-info__copy-trigger"
                data-copy-value={email}
                data-copy-toast={copyUi.emailCopied}
              >
                <span>{email}</span>
                <span class="contact-copy-subtext">{copyUi.copy}</span>
              </button>
            </div>
          </li>
          <li>
            <div class="contact-info__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </div>
            <div>
              <div class="contact-info__label">{t(l, "Contact", "hoursTitle")}</div>
              <div class="contact-info__value">{t(l, "Contact", "hoursText")}</div>
            </div>
          </li>
        </ul>
      </div>

      <!-- Form column -->
      <div class="contact-form">
        <h2 class="contact-form__heading">{t(l, "Contact", "formTitle")}</h2>
        <form id="contact-form" class="contact-form__fields" novalidate>
          <div class="field-row">
            <div class="field">
              <label for="contact-name">{t(l, "Contact", "nameLabel")}</label>
              <input type="text" id="contact-name" name="name" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="contact-email">{t(l, "Contact", "emailLabel")}</label>
              <input type="email" id="contact-email" name="email" autocomplete="email" required />
            </div>
          </div>

          <div class="field">
            <label for="contact-phone">{t(l, "Contact", "phoneLabel")}</label>
            <input type="tel" id="contact-phone" name="phone" autocomplete="tel" />
          </div>

          <div class="field">
            <label for="contact-message">{t(l, "Contact", "messageLabel")}</label>
            <textarea id="contact-message" name="message" rows="5" required></textarea>
          </div>

          <div class="contact-form__actions">
            <button type="submit" class="btn contact-form__submit">
              {t(l, "Contact", "sendButton")}
            </button>
            <p data-form-status role="status" aria-live="polite" class="form-status hidden"></p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <hr class="hairline" />

  <!-- Map placeholder -->
  <section class="section">
    <div class="container">
      <div class="section__head section__head--left">
        <h2>{t(l, "Contact", "mapTitle")}</h2>
        <p>{t(l, "Contact", "mapDescription")}</p>
      </div>
      <div id="csa-map" class="map-embed" aria-label={t(l, "Contact", "mapTitle")}></div>

      <script is:inline>
        (function () {
          var LAT = 56.930468;
          var LNG = 8.870665;

          function initMap() {
            if (!document.getElementById("csa-map")) return;
            var map = L.map("csa-map", {
              center: [LAT, LNG],
              zoom: 14,
              scrollWheelZoom: false,
            });

            L.tileLayer(
              "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
              {
                attribution:
                  '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                subdomains: "abcd",
                maxZoom: 19,
              }
            ).addTo(map);

            var pinIcon = L.divIcon({
              className: "csa-pin",
              html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 28 36" fill="none"><path d="M14 0C6.268 0 0 6.268 0 14c0 10.5 14 22 14 22S28 24.5 28 14C28 6.268 21.732 0 14 0z" fill="#2B9854"/><circle cx="14" cy="14" r="6" fill="white"/><circle cx="14" cy="14" r="3.5" fill="#2B9854"/></svg>',
              iconSize: [28, 36],
              iconAnchor: [14, 36],
              popupAnchor: [0, -38],
            });

            L.marker([LAT, LNG], { icon: pinIcon })
              .addTo(map)
              .bindPopup(
                "<strong>Camping Slap Af</strong><br>Kærvang 7, Sejerslev<br>7900 Nykøbing M"
              )
              .openPopup();
          }

          var script = document.createElement("script");
          script.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
          script.onload = initMap;
          script.onerror = function () {
            console.error("Leaflet failed to load");
          };
          document.head.appendChild(script);
        })();
      </script>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ formSuccess, formError }}>
  var form = document.getElementById('contact-form');
  if (form) {
    var status = form.querySelector('[data-form-status]');
    var submit = form.querySelector('button[type="submit"]');

    function setStatus(message, tone) {
      if (!status) return;
      status.textContent = message;
      status.classList.remove('hidden', 'form-status--success', 'form-status--error');
      status.classList.add(tone === 'error' ? 'form-status--error' : 'form-status--success');
    }

    form.addEventListener('submit', function(event) {
      event.preventDefault();
      var data = new FormData(form);
      var payload = {
        name: String(data.get('name') || ''),
        email: String(data.get('email') || ''),
        phone: String(data.get('phone') || ''),
        message: String(data.get('message') || ''),
      };

      if (submit) submit.disabled = true;
      if (status) status.classList.add('hidden');

      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).then(function(res) {
        if (!res.ok) throw new Error('status ' + res.status);
        setStatus(formSuccess, 'success');
        form.reset();
      }).catch(function(err) {
        console.error('contact submit failed', err);
        setStatus(formError, 'error');
      }).finally(function() {
        if (submit) submit.disabled = false;
      });
    });
  }
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-12);
    }
  }

  /* Info column */
  .contact-info__heading {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-7);
  }
  .contact-info__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .contact-info__list > li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .contact-info__icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-cream);
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .contact-info__icon svg {
    width: 22px;
    height: 22px;
  }
  .contact-info__label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-ink);
    margin-bottom: 2px;
  }
  .contact-info__value {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }
  .contact-info__value--link {
    color: var(--color-muted);
  }
  .contact-info__value--link:hover {
    color: var(--color-green);
  }
  .contact-info__copy-trigger {
    display: inline-flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    min-width: min(100%, 24rem);
    text-align: left;
  }
  .contact-info__copy-trigger:hover .contact-copy-subtext {
    color: var(--color-green);
  }

  /* Form column */
  .contact-form {
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .contact-form__heading {
    font-size: var(--fs-xl);
    margin: 0 0 var(--space-2);
  }
  .contact-form__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 600px) {
    .field-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
  }
  .field label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ink);
  }
  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: var(--fs-base);
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-md);
    padding: 0.7rem 0.9rem;
    line-height: 1.4;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-green);
    box-shadow: 0 0 0 3px rgba(43, 152, 84, 0.18);
  }
  .contact-form__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-1);
  }
  .contact-form__submit {
    align-self: flex-start;
  }

  @media (min-width: 720px) {
    .contact-form__actions {
      align-items: flex-start;
    }
  }

  /* Map */
  .map-embed {
    width: 100%;
    height: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-hairline);
  }

  :global(.csa-pin) {
    background: none;
    border: none;
  }
  :global(.csa-pin svg) {
    width: 28px;
    height: 36px;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.22));
  }
  :global(.leaflet-popup-content-wrapper) {
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    font-family: var(--font-body);
    font-size: 13px;
  }
  :global(.leaflet-popup-content strong) {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .form-status {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }
  .form-status.hidden { display: none; }
  .form-status--success { color: var(--color-green); }
  .form-status--error { color: #c0392b; }
</style>
