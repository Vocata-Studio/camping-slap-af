---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Siden blev ikke fundet" locale="da">
  <section class="not-found">
    <div class="container not-found__inner">
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Siden blev ikke fundet</h1>
      <p class="not-found__subtitle">Page not found</p>
      <p class="not-found__text">
        Den side du leder efter findes ikke eller er blevet flyttet.<br />
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/da/" class="btn">Gå til forsiden</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) var(--space-6);
  }
  .not-found__inner {
    text-align: center;
    max-width: 44ch;
  }
  .not-found__code {
    font-family: var(--font-heading);
    font-size: clamp(5rem, 20vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-green);
    margin-bottom: var(--space-4);
  }
  .not-found__title {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-2);
  }
  .not-found__subtitle {
    font-size: var(--fs-lg);
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }
  .not-found__text {
    color: var(--color-muted);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    margin-bottom: var(--space-8);
  }
</style>
