---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { isValidLocale } from "../../i18n/utils";
import type { Locale } from "../../i18n/utils";
import { getSite, photo, photoAlt } from "../../lib/site";
import { getProseDoc, proseEdited, proseIn } from "../../lib/prose";
import { HUSREGLER, type Lang } from "../../lib/prose-spec";

// Server-rendered so editor changes in Vocata CMS show without a rebuild.
export const prerender = false;

const { locale } = Astro.params;
if (!isValidLocale(locale)) return Astro.rewrite("/404");
const l = locale as Locale;

const titles: Record<Locale, string> = {
  da: "Husregler",
  en: "House Rules",
  de: "Hausordnung",
  nl: "Campingregels",
  fr: "Règlement intérieur",
  es: "Normas de convivencia",
  it: "Regolamento interno",
  sv: "Ordningsregler",
  nb: "Ordensregler",
  pl: "Regulamin",
};

const subtitles: Record<Locale, string> = {
  da: "Regler for en god oplevelse for alle",
  en: "Rules for a great stay for everyone",
  de: "Regeln für ein angenehmes Erlebnis für alle",
  nl: "Regels voor een fijn verblijf voor iedereen",
  fr: "Rules for a great stay for everyone",
  es: "Rules for a great stay for everyone",
  it: "Rules for a great stay for everyone",
  sv: "Rules for a great stay for everyone",
  nb: "Rules for a great stay for everyone",
  pl: "Rules for a great stay for everyone",
};

// Rules and closing note come from the CMS per language (built-in text as fallback).
const doc = await getProseDoc(Astro.locals, HUSREGLER);

type LocaleBlock = { label: string; rules: string[]; note: string };

const block = (lang: Lang, label: string): LocaleBlock => {
  const p = proseIn(lang, doc, HUSREGLER);
  return { label, rules: p.regler.map((r) => r.tekst).filter((r) => r !== ""), note: p.note };
};

const enBlock = block("en", "English");
const daBlock = block("da", "Dansk");
const nlBlock = block("nl", "Nederlands");
// If the rules were changed in Danish/English but not yet in German, the
// German page shows only the up-to-date English list.
const deOutdated = proseEdited(doc, HUSREGLER, ["da", "en"]) && !proseEdited(doc, HUSREGLER, ["de"]);

// first = primary (green), second = secondary (ink), null = no secondary
const blocks: [LocaleBlock, LocaleBlock | null] =
  l === "da" ? [daBlock, enBlock] :
  l === "de" ? (deOutdated ? [enBlock, null] : [block("de", "Deutsch"), enBlock]) :
  l === "nl" ? [nlBlock, enBlock] :
  l === "en" ? [enBlock, daBlock] :
  [enBlock, null];

const [firstBlock, secondBlock] = blocks;

const site = await getSite(Astro.locals);
const heroImage = photo(site, "husorden", "hero", "/images/location-images/kiosk-exterior-bench.webp");
const title = titles[l];
const subtitle = subtitles[l];
---

<Layout title={title} locale={l} description={subtitle} preloadImage={heroImage}>
  <Hero
    image={heroImage}
    imageAlt={photoAlt(site, "husorden", "hero", title)}
    title={title}
    subtitle={subtitle}
    compact
  />

  <section class="section section--tight">
    <div class="container rules-grid">
      <div class="rules-block">
        <span class="lang-label">{firstBlock.label}</span>
        <ul class="rules-list">
          {firstBlock.rules.map((rule) => (
            <li><span class="dot"></span>{rule}</li>
          ))}
        </ul>
        <p class="relax-note">{firstBlock.note}</p>
      </div>

      {secondBlock && (
        <div class="rules-block secondary">
          <span class="lang-label">{secondBlock.label}</span>
          <ul class="rules-list">
            {secondBlock.rules.map((rule) => (
              <li>
                <span class="dot" style="background: var(--color-ink)"></span>
                {rule}
              </li>
            ))}
          </ul>
          <p class="relax-note">{secondBlock.note}</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .rules-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-16);
    max-width: 560px;
  }

  .rules-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .lang-label {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-green);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--color-green);
  }

  .secondary .lang-label {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rules-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--color-ink);
  }

  .secondary .rules-list li {
    font-size: var(--fs-sm);
  }

  .dot {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-green);
    margin-top: 0.55em;
  }

  .relax-note {
    margin: 0;
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-green);
  }

  .secondary .relax-note {
    color: var(--color-ink);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

</style>
