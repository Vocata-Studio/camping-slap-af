---
import { t } from "../i18n/utils";
import type { Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = t(locale, "Header", "themeToggle");
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <svg
    data-theme-icon="sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    data-theme-icon="moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var STORAGE_KEY = "campingslapaf.theme";

    function syncIcons() {
      var dark = document.documentElement.getAttribute("data-theme") === "dark";
      document.querySelectorAll('[data-theme-icon="sun"]').forEach(function (el) {
        el.style.display = dark ? "block" : "none";
      });
      document.querySelectorAll('[data-theme-icon="moon"]').forEach(function (el) {
        el.style.display = dark ? "none" : "block";
      });
    }

    function apply(next) {
      document.documentElement.setAttribute("data-theme", next);
      try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
      syncIcons();
    }

    syncIcons();

    document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme");
        var next = current === "dark" ? "light" : "dark";
        if (typeof document.startViewTransition === "function") {
          document.startViewTransition(function () { apply(next); });
        } else {
          apply(next);
        }
      });
    });
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-ink);
    background: transparent;
    border: 0;
  }
  .theme-toggle:hover {
    color: var(--color-green);
  }
  .theme-toggle svg {
    display: none;
  }
</style>
