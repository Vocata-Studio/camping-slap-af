---
import type { Locale } from "../i18n/utils";
import { t, bookingHref } from "../i18n/utils";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
---

<section class="section">
  <div class="container">
    <a href={bookingHref(locale)} class="cta-card" target="_blank" rel="noopener noreferrer">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 200 200"
        class="cta-card__tree"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M100 10 L140 80 L125 80 L155 140 L135 140 L165 190 L35 190 L65 140 L45 140 L75 80 L60 80 Z" />
        <rect x="90" y="175" width="20" height="25" />
      </svg>

      <div class="cta-card__body">
        <span class="cta-card__badge">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
          </svg>
          {t(locale, "Common", "newReservation")}
        </span>
        <h2 class="cta-card__title">{t(locale, "Home", "ctaTitle")}</h2>
        <p class="cta-card__desc">{t(locale, "Home", "ctaDescription")}</p>
        <span class="cta-card__btn">
          {t(locale, "Home", "ctaButton")}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"
            />
          </svg>
        </span>
      </div>
    </a>
  </div>
</section>

<style>
  .cta-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    background:
      linear-gradient(135deg, var(--color-white) 0%, var(--color-cream) 55%, rgba(119, 186, 138, 0.3) 100%);
    padding: var(--space-7);
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04);
    transition: box-shadow 200ms ease, transform 200ms ease;
    text-decoration: none;
    color: var(--color-ink);
  }
  .cta-card:hover {
    box-shadow: 0 8px 24px rgba(26, 26, 26, 0.08);
  }
  .cta-card__tree {
    position: absolute;
    right: -1rem;
    bottom: -1rem;
    width: 11rem;
    height: 11rem;
    color: var(--color-green);
    opacity: 0.1;
    pointer-events: none;
  }
  .cta-card__body {
    position: relative;
    z-index: 1;
  }
  .cta-card__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(43, 152, 84, 0.1);
    color: var(--color-green);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.4;
  }
  .cta-card__badge svg {
    width: 0.875rem;
    height: 0.875rem;
  }
  .cta-card__title {
    font-family: var(--font-heading);
    font-size: var(--fs-2xl);
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }
  .cta-card__desc {
    margin-top: var(--space-3);
    max-width: 52ch;
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }
  .cta-card__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-green);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.06);
    transition: transform 200ms ease, background-color 200ms ease;
  }
  .cta-card__btn svg {
    width: 1rem;
    height: 1rem;
    transition: transform 200ms ease;
  }
  .cta-card:hover .cta-card__btn {
    background: var(--color-green-dark);
    transform: scale(1.02);
  }
  .cta-card:hover .cta-card__btn svg {
    transform: translateX(2px);
  }
</style>
