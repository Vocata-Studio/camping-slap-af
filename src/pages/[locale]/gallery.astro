---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { locales, isValidLocale, t } from "../../i18n/utils";
import type { Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isValidLocale(locale)) return Astro.redirect("/da");
const l = locale as Locale;

const heroImage = "/images/old-gerlis-placeholder.webp";

const photos = [
  { src: "/images/location-images/20260427_112848.jpg", altKey: "kitchenAlt", captionKey: "kitchenCaption", format: "square" },
  { src: "/images/location-images/20260427_113003.jpg", altKey: "commonArea1Alt", captionKey: "commonAreaCaption", format: "square" },
  { src: "/images/location-images/20260427_113055.jpg", altKey: "commonArea2Alt", captionKey: "commonAreaCaption", format: "square" },
  { src: "/images/location-images/20260427_113129.jpg", altKey: "cabinAlt", captionKey: "cabinCaption", format: "square" },
  { src: "/images/location-images/20260427_113206.jpg", altKey: "kioskAlt", captionKey: "kioskCaption", format: "square" },
  { src: "/images/location-images/20260427_113219.jpg", altKey: "showerAlt", captionKey: "showerCaption", format: "square" },
  { src: "/images/location-images/20260427_113449.jpg", altKey: "restroomsAlt", captionKey: "restroomsCaption", format: "square" },
  { src: "/images/location-images/20260427_164517.jpg", altKey: "site1Alt", captionKey: "siteCaption", format: "portrait" },
  { src: "/images/location-images/20260427_164637.jpg", altKey: "site2Alt", captionKey: "siteCaption", format: "portrait" },
  { src: "/images/location-images/20260427_164737.jpg", altKey: "site3Alt", captionKey: "siteCaption", format: "portrait" },
  { src: "/images/location-images/20260427_164750.jpg", altKey: "site4Alt", captionKey: "siteCaption", format: "portrait" },
] as const;

const lightboxData = photos.map((p) => ({
  src: p.src,
  alt: t(l, "Gallery", p.altKey),
  caption: t(l, "Gallery", p.captionKey),
}));
---

<Layout title={t(l, "Gallery", "title")} locale={l}>
  <Hero
    image={heroImage}
    imageAlt={t(l, "Gallery", "title")}
    title={t(l, "Gallery", "title")}
    subtitle={t(l, "Gallery", "subtitle")}
    compact
  />

  <section class="section">
    <div class="container">
      <ul class="gallery">
        {
          photos.map((photo, i) => (
            <li class:list={["gallery__item", `gallery__item--${photo.format}`]}>
              <button
                type="button"
                class="gallery__trigger"
                data-index={i}
                aria-label={t(l, "Gallery", photo.altKey)}
              >
                <span class:list={["gallery__media", `gallery__media--${photo.format}`]}>
                  <img src={photo.src} alt={t(l, "Gallery", photo.altKey)} loading="lazy" />
                </span>
                <span class="gallery__caption">{t(l, "Gallery", photo.captionKey)}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <hr class="hairline" />

  <!-- Before & After -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <h2>{t(l, "Gallery", "beforeAfterTitle")}</h2>
        <p>{t(l, "Gallery", "beforeAfterSubtitle")}</p>
      </div>
      <div class="ba-grid">
        <div class="ba-card">
          <div class="ba-card__label">{t(l, "Gallery", "beforeLabel")}</div>
          <div class="ba-card__media">
            <img src="/images/old-gerlis-placeholder.webp" alt={t(l, "Gallery", "beforeLabel")} loading="lazy" />
          </div>
        </div>
        <div class="ba-card">
          <div class="ba-card__label">{t(l, "Gallery", "afterLabel")}</div>
          <div class="ba-card__media ba-card__media--placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
              <circle cx="9" cy="9" r="2" />
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
            </svg>
            <span>{t(l, "Gallery", "afterComingSoon")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog
    class="lightbox"
    id="gallery-lightbox"
    aria-label={t(l, "Gallery", "title")}
  >
    <button
      type="button"
      class="lightbox__close"
      data-action="close"
      aria-label={t(l, "Gallery", "lightboxClose")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
    <button
      type="button"
      class="lightbox__nav lightbox__nav--prev"
      data-action="prev"
      aria-label={t(l, "Gallery", "lightboxPrev")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <figure class="lightbox__figure">
      <div class="lightbox__media">
        <img class="lightbox__image" src="" alt="" />
      </div>
      <figcaption class="lightbox__caption"></figcaption>
      <div class="lightbox__counter" aria-hidden="true"></div>
    </figure>
    <button
      type="button"
      class="lightbox__nav lightbox__nav--next"
      data-action="next"
      aria-label={t(l, "Gallery", "lightboxNext")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </dialog>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(lightboxData)} />

  <script is:inline>
    (() => {
      const dataEl = document.getElementById("gallery-data");
      if (!dataEl) return;
      const photos = JSON.parse(dataEl.textContent || "[]");
      const dialog = document.getElementById("gallery-lightbox");
      if (!dialog || !photos.length) return;

      const img = dialog.querySelector(".lightbox__image");
      const captionEl = dialog.querySelector(".lightbox__caption");
      const counterEl = dialog.querySelector(".lightbox__counter");
      const triggers = document.querySelectorAll(".gallery__trigger");
      let current = 0;

      function show(i) {
        current = ((i % photos.length) + photos.length) % photos.length;
        const item = photos[current];
        img.src = item.src;
        img.alt = item.alt;
        captionEl.textContent = item.caption;
        counterEl.textContent = `${current + 1} / ${photos.length}`;
      }

      triggers.forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          show(idx);
          if (typeof dialog.showModal === "function") {
            dialog.showModal();
          } else {
            dialog.setAttribute("open", "");
          }
        });
      });

      dialog.addEventListener("click", (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const action = target.closest("[data-action]")?.getAttribute("data-action");
        if (action === "close") {
          dialog.close();
        } else if (action === "prev") {
          show(current - 1);
        } else if (action === "next") {
          show(current + 1);
        } else if (target === dialog) {
          dialog.close();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (!dialog.open) return;
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          show(current - 1);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          show(current + 1);
        }
      });
    })();
  </script>
</Layout>

<style>
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-7);
    }
  }

  .gallery__item {
    margin: 0;
  }
  .gallery__trigger {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    width: 100%;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: inherit;
    font: inherit;
  }
  .gallery__trigger:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }
  .gallery__media {
    display: block;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-cream);
  }
  .gallery__media--square {
    aspect-ratio: 1 / 1;
  }
  .gallery__media--portrait {
    aspect-ratio: 3 / 4;
  }
  .gallery__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gallery__caption {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  /* Lightbox */
  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-white);
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    inset: 0;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }
  .lightbox[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: 1fr;
    align-items: center;
    justify-items: center;
    padding: var(--space-5);
    box-sizing: border-box;
  }

  .lightbox__close {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 0;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
  }
  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lightbox__close svg {
    width: 22px;
    height: 22px;
  }

  .lightbox__nav {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 0;
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-white);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lightbox__nav svg {
    width: 24px;
    height: 24px;
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  .lightbox__media {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
  }
  .lightbox__caption {
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--fs-md);
    line-height: 1.5;
    text-align: center;
    max-width: 70ch;
    padding: 0 var(--space-4);
  }
  .lightbox__counter {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--fs-xs);
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .lightbox[open] {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      padding: var(--space-3);
    }
    .lightbox__nav {
      position: fixed;
      bottom: var(--space-5);
      width: 44px;
      height: 44px;
      z-index: 10;
    }
    .lightbox__nav--prev {
      left: var(--space-4);
    }
    .lightbox__nav--next {
      right: var(--space-4);
    }
  }

  /* Before & After */
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .ba-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .ba-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    background: var(--color-white);
  }
  .ba-card__label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: var(--space-3) var(--space-5);
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .ba-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .ba-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ba-card__media--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    background: var(--color-cream);
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }
  .ba-card__media--placeholder svg {
    width: 40px;
    height: 40px;
    color: var(--color-mint);
  }
</style>
