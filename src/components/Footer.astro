---
import { navLinks, bookingLink, bookingHref, contactUi, localePath, t } from "../i18n/utils";
import type { Locale } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
const copyright = t(locale, "Footer", "copyright").replace("{year}", String(year));
const copyUi = contactUi(locale);
const phone = t(locale, "Footer", "phone");
const email = t(locale, "Footer", "email");
const cvr = t(locale, "Footer", "cvr");
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href={localePath(locale, "/")} class="site-footer__brand-link" aria-label="Camping Slap Af">
        <img
          src="/CSA-logo-final.png"
          alt=""
          width="170"
          height="170"
          class="site-footer__logo"
        />
        <span class="site-footer__wordmark">Camping Slap Af</span>
      </a>
      <p class="site-footer__tagline">{t(locale, "Footer", "tagline")}</p>
      <div class="site-footer__social">
        <a
          href="https://www.facebook.com/profile.php?id=61584886509520"
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__social-link"
          aria-label={t(locale, "Footer", "facebook")}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="site-footer__col">
      <h4 class="site-footer__heading">{t(locale, "Footer", "quickLinks")}</h4>
      <ul class="site-footer__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={localePath(locale, link.href)} class="site-footer__link">
                {t(locale, "Header", link.key)}
              </a>
            </li>
          ))
        }
        <li>
          <a href={bookingHref(locale)} class="site-footer__link">
            {t(locale, "Header", bookingLink.key)}
          </a>
        </li>
        <li>
          <a href={localePath(locale, "/houserules")} class="site-footer__link">
            {t(locale, "Footer", "houserules")}
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h4 class="site-footer__heading">{t(locale, "Footer", "contactInfo")}</h4>
      <ul class="site-footer__contact">
        <li>
          <button
            type="button"
            class="site-footer__link site-footer__copy-link"
            data-copy-value={email}
            data-copy-toast={copyUi.emailCopied}
          >
            <span>{email}</span>
            <span class="contact-copy-subtext">{copyUi.copy}</span>
          </button>
        </li>
        <li>
          <a
            href={`tel:${phone.replace(/\s+/g, "")}`}
            class="site-footer__link site-footer__copy-link"
            data-copy-value={phone}
            data-copy-toast={copyUi.phoneCopied}
            data-copy-mobile-call="true"
          >
            <span>{phone}</span>
            <span class="contact-copy-subtext">{copyUi.copy}</span>
          </a>
        </li>
        <li>
          <button
            type="button"
            class="site-footer__link site-footer__copy-link"
            data-copy-value={cvr}
            data-copy-toast={copyUi.cvrCopied}
          >
            <span>CVR: {cvr}</span>
            <span class="contact-copy-subtext">{copyUi.copy}</span>
          </button>
        </li>
        <li class="site-footer__address">{t(locale, "Footer", "address")}</li>
      </ul>
    </div>
  </div>

  <div class="container site-footer__base">
    <div class="site-footer__base-inner">
      <div class="site-footer__base-left">
        <p class="site-footer__copyright">{copyright}</p>
        <ul class="site-footer__legal">
          <li>
            <a href={localePath(locale, "/privacy")} class="site-footer__link">
              {t(locale, "Footer", "privacy")}
            </a>
          </li>
          <li>
            <a href={localePath(locale, "/terms")} class="site-footer__link">
              {t(locale, "Footer", "terms")}
            </a>
          </li>
          <li>
            <a href={localePath(locale, "/accessibility")} class="site-footer__link">
              {t(locale, "Footer", "accessibility")}
            </a>
          </li>
        </ul>
        <ThemeToggle locale={locale} />
      </div>
      <div class="site-footer__partners">
        <a href="https://www.dk-camp.dk" target="_blank" rel="noopener noreferrer" class="site-footer__dkcamp">
          <img
            src="/images/dk-camp-logo.png"
            alt={t(locale, "Footer", "dkCampAlt")}
            width="100"
            height="40"
            class="site-footer__dkcamp-logo"
          />
        </a>
        <a
          href="https://svr.nl/"
          target="_blank"
          rel="noopener"
          title={t(locale, "Footer", "svrAlt")}
          class="site-footer__svr"
        >
          <img
            src="/images/svr_logo.png"
            alt={t(locale, "Footer", "svrAlt")}
            width="80"
            height="40"
            class="site-footer__svr-logo"
          />
        </a>
        <a href="https://www.dk-camp.dk/inspiration/smaa-campingpladser/" target="_blank" rel="noopener noreferrer" class="site-footer__smaacamping">
          <img
            src="/images/smaa-pladsers-logo.png"
            alt={t(locale, "Footer", "smaaCampingAlt")}
            width="80"
            height="40"
            class="site-footer__smaacamping-logo"
          />
        </a>
        <a href="https://www.visitmors.dk/" target="_blank" rel="noopener noreferrer" class="site-footer__visitmors">
          <img
            src="/images/visitmors.dk-favicon.png"
            alt={t(locale, "Footer", "visitMorsAlt")}
            width="40"
            height="40"
            class="site-footer__visitmors-logo"
          />
        </a>
      </div>
    </div>
  </div>

  <a
    href="https://vocata.studio/"
    target="_blank"
    rel="noopener noreferrer"
    class="block bg-[#2B9854] border-t border-white/10 transition-colors hover:bg-[#22793F]"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-center gap-4 px-6 py-4">
      <img
        src="/vocata-signature.png"
        alt="Vocata Studio"
        class="h-[1.875rem] w-[1.875rem] shrink-0 object-contain"
      />
      <span class="text-[0.85rem] font-medium text-white">
        Designet &amp; Udviklet af Vocata Studio
      </span>
    </div>
  </a>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-hairline);
    background: var(--color-bg);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-top: var(--space-10);
    padding-bottom: var(--space-8);
  }

  .site-footer__brand-link {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    color: var(--color-ink);
  }
  .site-footer__brand-link:hover {
    color: var(--color-ink);
  }
  .site-footer__brand-link:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .site-footer__logo {
    width: 170px;
    height: 170px;
    object-fit: contain;
    margin-bottom: -0.25rem;
  }
  .site-footer__wordmark {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.125rem;
  }
  .site-footer__tagline {
    margin-top: var(--space-3);
    color: var(--color-muted);
    max-width: 32ch;
  }

  .site-footer__social {
    margin-top: var(--space-4);
  }
  .site-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
  }
  .site-footer__social-link:hover {
    color: var(--color-green);
    border-color: var(--color-green);
  }
  .site-footer__social-link:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }

  .site-footer__heading {
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    margin-bottom: var(--space-4);
  }

  .site-footer__links,
  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--fs-sm);
  }

  .site-footer__link {
    color: var(--color-muted);
  }
  .site-footer__link:hover {
    color: var(--color-green);
  }
  .site-footer__copy-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    text-align: left;
  }
  .site-footer__address {
    margin-top: var(--space-3);
  }
  .site-footer__copy-link:hover .contact-copy-subtext {
    color: var(--color-green);
  }

  .site-footer__base {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }
  .site-footer__base-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .site-footer__copyright {
    font-size: var(--fs-xs);
    color: var(--color-muted);
    margin: 0;
  }
  .site-footer__base-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }
  .site-footer__legal {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--fs-xs);
    margin: 0;
    padding: 0;
  }
  .site-footer__legal li {
    list-style: none;
  }
  .site-footer__legal .site-footer__link {
    font-size: var(--fs-xs);
  }
  .site-footer__partners {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }
  .site-footer__dkcamp,
  .site-footer__visitmors {
    display: inline-block;
  }
  .site-footer__dkcamp-logo {
    height: 56px;
    width: auto;
    object-fit: contain;
    opacity: 0.8;
  }
  .site-footer__visitmors-logo {
    height: 56px;
    width: 56px;
    object-fit: contain;
    opacity: 0.8;
  }
  .site-footer__smaacamping {
    display: inline-block;
  }
  .site-footer__smaacamping-logo {
    height: 56px;
    width: auto;
    object-fit: contain;
    opacity: 0.8;
  }
  .site-footer__svr {
    display: inline-block;
  }
  .site-footer__svr-logo {
    height: 56px;
    width: auto;
    object-fit: contain;
    opacity: 0.8;
  }
  .site-footer__dkcamp:hover .site-footer__dkcamp-logo,
  .site-footer__visitmors:hover .site-footer__visitmors-logo,
  .site-footer__smaacamping:hover .site-footer__smaacamping-logo,
  .site-footer__svr:hover .site-footer__svr-logo {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: var(--space-10);
    }
  }
</style>
