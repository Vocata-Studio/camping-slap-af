---
import { t } from "../i18n/utils";
import type { Locale } from "../i18n/utils";
import { getReviews } from "../lib/vocata";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const cmsReviews = await getReviews();

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

// Anchor-ify plain http(s) URLs inside review quotes. Trailing punctuation is
// excluded from the link target so "see foo.com." doesn't grab the period.
function linkify(text: string): string {
  const escaped = escapeHtml(text);
  return escaped.replace(/https?:\/\/[^\s<]+/g, (raw) => {
    const trailingMatch = raw.match(/[.,!?;:)\]]+$/);
    const trailing = trailingMatch ? trailingMatch[0] : "";
    const url = trailing ? raw.slice(0, -trailing.length) : raw;
    return `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>${trailing}`;
  });
}

interface DisplayReview {
  name: string;
  location: string | null;
  rating: number | null;
  quoteHtml: string;
}

const reviews: DisplayReview[] = cmsReviews
  .filter((r) => r.data?.name && r.data?.quoteDa)
  .map((r) => {
    const quote = locale === "da"
      ? r.data.quoteDa
      : (r.data.quoteEn ?? r.data.quoteDa);
    const rating = typeof r.data.rating === "number"
      ? Math.max(0, Math.min(5, Math.round(r.data.rating)))
      : null;
    return {
      name: r.data.name,
      location: r.data.location ?? null,
      rating,
      quoteHtml: linkify(quote),
    };
  });

const hasReviews = reviews.length > 0;

const labels = {
  title: t(locale, "Home", "testimonialTitle"),
  emptyTitle: t(locale, "Home", "testimonialComingSoonTitle"),
  emptyText: t(locale, "Home", "testimonialComingSoonText"),
  prev: t(locale, "Reviews", "prev"),
  next: t(locale, "Reviews", "next"),
  ratingLabel: t(locale, "Reviews", "ratingLabel"),
};
---

<section class="section">
  <div class="container">
    <div class="section__head">
      <h2>{labels.title}</h2>
    </div>

    {hasReviews ? (
      <div class="reviews" data-reviews>
        <div class="reviews__track" data-track>
          {reviews.map((r) => (
            <article class="review-card">
              {r.rating !== null && (
                <div
                  class="review-card__stars"
                  role="img"
                  aria-label={`${labels.ratingLabel}: ${r.rating} / 5`}
                >
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg
                      class:list={["review-card__star", i < (r.rating ?? 0) && "review-card__star--on"]}
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d="M12 2.5l2.95 5.98 6.6.96-4.78 4.66 1.13 6.58L12 17.6l-5.9 3.08 1.13-6.58L2.45 9.44l6.6-.96L12 2.5z" />
                    </svg>
                  ))}
                </div>
              )}
              <blockquote class="review-card__quote" set:html={r.quoteHtml} />
              <div class="review-card__attribution">
                <span class="review-card__name">{r.name}</span>
                {r.location && <span class="review-card__location">{r.location}</span>}
              </div>
            </article>
          ))}
        </div>

        <div class="reviews__nav" data-nav hidden>
          <button
            type="button"
            class="reviews__nav-btn"
            data-prev
            aria-label={labels.prev}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            type="button"
            class="reviews__nav-btn"
            data-next
            aria-label={labels.next}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
      </div>
    ) : (
      <div class="testimonial-soon">
        <div class="testimonial-soon__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
          </svg>
        </div>
        <h3 class="testimonial-soon__title">{labels.emptyTitle}</h3>
        <p class="testimonial-soon__text">{labels.emptyText}</p>
      </div>
    )}
  </div>
</section>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll("[data-reviews]");
    for (var i = 0; i < roots.length; i++) {
      (function (root) {
        var track = root.querySelector("[data-track]");
        var nav = root.querySelector("[data-nav]");
        var prev = root.querySelector("[data-prev]");
        var next = root.querySelector("[data-next]");
        if (!track || !nav || !prev || !next) return;

        function updateNav() {
          // Show arrows only if the track actually overflows.
          var overflow = track.scrollWidth - track.clientWidth > 1;
          nav.hidden = !overflow;
          if (!overflow) return;
          var max = track.scrollWidth - track.clientWidth;
          var x = track.scrollLeft;
          prev.disabled = x <= 1;
          next.disabled = x >= max - 1;
        }

        function pageWidth() {
          // Step by the visible width — exactly 3 cards on desktop, 2 on
          // tablet, 1 on mobile thanks to scroll-snap and the responsive
          // card widths.
          return track.clientWidth;
        }

        prev.addEventListener("click", function () {
          track.scrollBy({ left: -pageWidth(), behavior: "smooth" });
        });
        next.addEventListener("click", function () {
          track.scrollBy({ left: pageWidth(), behavior: "smooth" });
        });
        track.addEventListener("scroll", updateNav, { passive: true });
        window.addEventListener("resize", updateNav);
        updateNav();
      })(roots[i]);
    }
  })();
</script>

<style>
  .reviews {
    position: relative;
  }

  /* Horizontal scroll-snap track: lets the same DOM serve 3-up on desktop,
     2-up on tablet, 1-up on mobile, with the browser handling the snap. */
  .reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--space-5) * 2) / 3);
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
  }
  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  .review-card {
    scroll-snap-align: start;
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
    color: var(--color-green);
  }
  .review-card__star {
    width: 18px;
    height: 18px;
    fill: var(--color-hairline-strong);
  }
  .review-card__star--on {
    fill: currentColor;
  }

  .review-card__quote {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    white-space: pre-line;
    flex: 1;
  }
  .review-card__quote::before {
    content: "\201C";
    font-family: var(--font-heading);
    font-size: 2.5rem;
    line-height: 0;
    vertical-align: -0.4em;
    margin-right: 0.15rem;
    color: var(--color-green);
  }
  .review-card__quote a {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 2px;
    word-break: break-word;
  }
  .review-card__quote a:hover {
    color: var(--color-mint);
  }

  .review-card__attribution {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-hairline);
  }
  .review-card__name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-sm);
    color: var(--color-ink);
  }
  .review-card__location {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  /* Nav arrows under the grid — small, centered, pill-style to match
     the rest of the site. Hidden via [hidden] when nothing overflows. */
  .reviews__nav {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .reviews__nav[hidden] {
    display: none;
  }
  .reviews__nav-btn {
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    background: var(--color-bg);
  }
  .reviews__nav-btn:hover {
    background: var(--color-cream);
    color: var(--color-green);
    border-color: var(--color-hairline-strong);
  }
  .reviews__nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .reviews__nav-btn:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }
  .reviews__nav-btn svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 900px) {
    .reviews__track {
      grid-auto-columns: calc((100% - var(--space-5)) / 2);
    }
  }
  @media (max-width: 640px) {
    .reviews__track {
      grid-auto-columns: 100%;
      gap: var(--space-4);
    }
    .review-card {
      padding: var(--space-5);
    }
  }

  /* Empty-state — same look as the original "coming soon" block so the
     page rhythm doesn't change before reviews land. */
  .testimonial-soon {
    max-width: 560px;
    margin-inline: auto;
    padding: var(--space-8) var(--space-6);
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .testimonial-soon__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-green);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .testimonial-soon__icon svg {
    width: 26px;
    height: 26px;
  }
  .testimonial-soon__title {
    font-size: var(--fs-lg);
    margin: 0;
  }
  .testimonial-soon__text {
    color: var(--color-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    max-width: 46ch;
    margin: 0;
  }
</style>
