---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { locales, isValidLocale, t } from "../../i18n/utils";
import type { Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isValidLocale(locale)) return Astro.redirect("/da");
const l = locale as Locale;

const heroImage = "/billeder-fra-anders/cabins-lawn.webp";

const photos = [
  { src: "/billeder-fra-anders/campsite-overview.webp",                   altKey: "andersOverviewAlt",      captionKey: "andersOverviewCaption"      },
  { src: "/billeder-fra-anders/cabins-lawn.webp",                          altKey: "andersCabinsLawnAlt",    captionKey: "andersCabinsLawnCaption"    },
  { src: "/billeder-fra-anders/entrance-signpost.webp",                    altKey: "andersEntranceAlt",      captionKey: "andersEntranceCaption"      },
  { src: "/billeder-fra-anders/cabin9-exterior.webp",                      altKey: "andersCabin9ExteriorAlt",captionKey: "andersCabinExteriorCaption" },
  { src: "/billeder-fra-anders/cabin8-bedroom.webp",                       altKey: "andersCabin8BedroomAlt", captionKey: "andersCabinBedroomCaption"  },
  { src: "/billeder-fra-anders/cabin9-kitchen.webp",                       altKey: "andersCabin9KitchenAlt", captionKey: "andersCabinKitchenCaption"  },
  { src: "/billeder-fra-anders/guests-caravan.webp",                       altKey: "andersGuestsAlt",        captionKey: "andersGuestsCaption"        },
  { src: "/billeder-fra-anders/reception-kiosk.webp",                      altKey: "andersReceptionAlt",     captionKey: "andersReceptionCaption"     },
  { src: "/billeder-fra-anders/vegetable-garden.webp",                     altKey: "andersGardenAlt",        captionKey: "andersGardenCaption"        },
  { src: "/images/location-images/facilities-shared-kitchen.webp",         altKey: "kitchenAlt",             captionKey: "kitchenCaption"             },
  { src: "/images/location-images/facilities-common-room.webp",            altKey: "commonArea1Alt",         captionKey: "commonAreaCaption"          },
  { src: "/images/location-images/facilities-common-room-entrance.webp",   altKey: "commonArea2Alt",         captionKey: "commonAreaCaption"          },
  { src: "/images/location-images/cabins-exterior-path.webp",              altKey: "cabinAlt",               captionKey: "cabinCaption"               },
  { src: "/images/location-images/kiosk-exterior-bench.webp",              altKey: "kioskAlt",               captionKey: "kioskCaption"               },
  { src: "/images/location-images/facilities-bathroom-shower.webp",        altKey: "showerAlt",              captionKey: "showerCaption"              },
  { src: "/images/location-images/facilities-toilet-stalls.webp",          altKey: "restroomsAlt",           captionKey: "restroomsCaption"           },
  { src: "/images/location-images/campsite-field-caravan.webp",            altKey: "site1Alt",               captionKey: "siteCaption"                },
] as const;

const lightboxData = photos.map((p) => ({
  src: p.src,
  alt: t(l, "Gallery", p.altKey),
  caption: t(l, "Gallery", p.captionKey),
}));
---

<Layout title={t(l, "Meta", "galleryTitle")} locale={l} description={t(l, "Meta", "galleryDescription")} ogImage={heroImage} preloadImage={heroImage}>
  <Hero
    image={heroImage}
    imageAlt={t(l, "Gallery", "title")}
    title={t(l, "Gallery", "title")}
    subtitle={t(l, "Gallery", "subtitle")}
    compact
  />

  <section class="section">
    <div class="container">
      <ul class="masonry" role="list">
        {photos.map((photo, i) => (
          <li class="masonry__item">
            <button
              type="button"
              class="masonry__btn"
              data-index={i}
              aria-label={t(l, "Gallery", photo.altKey)}
            >
              <img
                src={photo.src}
                alt={t(l, "Gallery", photo.altKey)}
                loading="lazy"
                decoding="async"
              />
              <span class="masonry__overlay" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="8" />
                  <path d="m21 21-4.35-4.35" />
                  <path d="M11 8v6M8 11h6" />
                </svg>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Lightbox -->
  <dialog class="lightbox" id="gallery-lightbox" aria-label={t(l, "Gallery", "title")}>
    <button
      type="button"
      class="lightbox__close"
      data-action="close"
      aria-label={t(l, "Gallery", "lightboxClose")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18" /><path d="m6 6 12 12" />
      </svg>
    </button>

    <button
      type="button"
      class="lightbox__nav lightbox__nav--prev"
      data-action="prev"
      aria-label={t(l, "Gallery", "lightboxPrev")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>

    <figure class="lightbox__figure">
      <div class="lightbox__frame">
        <img class="lightbox__img" src="" alt="" />
      </div>
      <figcaption class="lightbox__caption"></figcaption>
      <p class="lightbox__counter" aria-live="polite"></p>
    </figure>

    <button
      type="button"
      class="lightbox__nav lightbox__nav--next"
      data-action="next"
      aria-label={t(l, "Gallery", "lightboxNext")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
  </dialog>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(lightboxData)} />

  <script is:inline>
    (() => {
      const dataEl = document.getElementById("gallery-data");
      if (!dataEl) return;
      const photos = JSON.parse(dataEl.textContent || "[]");
      const dialog = document.getElementById("gallery-lightbox");
      if (!dialog || !photos.length) return;

      const img = dialog.querySelector(".lightbox__img");
      const captionEl = dialog.querySelector(".lightbox__caption");
      const counterEl = dialog.querySelector(".lightbox__counter");
      let current = 0;

      function show(i) {
        current = ((i % photos.length) + photos.length) % photos.length;
        const item = photos[current];
        img.src = item.src;
        img.alt = item.alt;
        captionEl.textContent = item.caption;
        counterEl.textContent = `${current + 1} / ${photos.length}`;
      }

      document.querySelectorAll(".masonry__btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          show(idx);
          dialog.showModal ? dialog.showModal() : dialog.setAttribute("open", "");
        });
      });

      dialog.addEventListener("click", (e) => {
        const action = e.target.closest?.("[data-action]")?.getAttribute("data-action");
        if (action === "close") dialog.close();
        else if (action === "prev") show(current - 1);
        else if (action === "next") show(current + 1);
        else if (e.target === dialog) dialog.close();
      });

      document.addEventListener("keydown", (e) => {
        if (!dialog.open) return;
        if (e.key === "ArrowLeft") { e.preventDefault(); show(current - 1); }
        else if (e.key === "ArrowRight") { e.preventDefault(); show(current + 1); }
      });
    })();
  </script>
</Layout>

<style>
  /* ── Masonry grid ─────────────────────────────────────────────────── */

  .masonry {
    columns: 2;
    column-gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .masonry {
      columns: 3;
      column-gap: var(--space-5);
    }
  }

  @media (max-width: 480px) {
    .masonry {
      columns: 1;
    }
  }

  .masonry__item {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 900px) {
    .masonry__item {
      margin-bottom: var(--space-5);
    }
  }

  .masonry__btn {
    position: relative;
    display: block;
    width: 100%;
    cursor: zoom-in;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-cream);
  }

  .masonry__btn:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 3px;
    border-radius: var(--radius-lg);
  }

  .masonry__btn img {
    width: 100%;
    height: auto;
    display: block;
    vertical-align: bottom;
  }

  .masonry__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-white);
  }

  .masonry__overlay svg {
    width: 30px;
    height: 30px;
    opacity: 0;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }

  .masonry__btn:hover .masonry__overlay {
    background: rgba(26, 26, 26, 0.28);
  }

  .masonry__btn:hover .masonry__overlay svg {
    opacity: 1;
  }

  /* ── Lightbox ─────────────────────────────────────────────────────── */

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--color-white);
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    inset: 0;
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.93);
  }

  .lightbox[open] {
    display: grid;
    grid-template-columns: 64px 1fr 64px;
    grid-template-rows: 1fr;
    align-items: center;
    justify-items: center;
    padding-block: var(--space-10);
    box-sizing: border-box;
  }

  /* Close */
  .lightbox__close {
    position: fixed;
    top: var(--space-5);
    right: var(--space-5);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-white);
    cursor: pointer;
    z-index: 10;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .lightbox__close svg {
    width: 20px;
    height: 20px;
  }

  /* Prev / next arrows */
  .lightbox__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-white);
    cursor: pointer;
    flex-shrink: 0;
  }

  .lightbox__nav:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .lightbox__nav svg {
    width: 22px;
    height: 22px;
  }

  /* Figure — center column */
  .lightbox__figure {
    margin: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding-inline: var(--space-3);
  }

  .lightbox__frame {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    display: block;
  }

  .lightbox__caption {
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--fs-sm);
    line-height: 1.55;
    text-align: center;
    max-width: 60ch;
    padding-inline: var(--space-4);
  }

  .lightbox__counter {
    font-family: var(--font-heading);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.35);
    text-transform: uppercase;
    margin: 0;
  }

  /* Mobile: stack arrows at bottom */
  @media (max-width: 600px) {
    .lightbox[open] {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
      padding: var(--space-4);
      padding-bottom: var(--space-16);
    }

    .lightbox__nav {
      position: fixed;
      bottom: var(--space-5);
      z-index: 10;
    }

    .lightbox__nav--prev {
      left: var(--space-5);
    }

    .lightbox__nav--next {
      right: var(--space-5);
    }
  }
</style>
