---
import { pickLocale, localeStorageKey } from "../i18n/utils";

// Server-side language redirect. The bare domain resolves the best locale from
// the visitor's remembered choice (cookie) or Accept-Language header and issues
// a real 302 — cleaner for crawlers than a JS/meta-refresh splash.
export const prerender = false;

const remembered = Astro.cookies.get(localeStorageKey)?.value ?? null;
const acceptLanguage = Astro.request.headers.get("accept-language");
const target = pickLocale(acceptLanguage, remembered);

// Build the redirect Response directly so the caching headers stick — the
// response varies per visitor (cookie + header), so it must not be cached.
return new Response(null, {
  status: 302,
  headers: {
    Location: `/${target}/${Astro.url.search}`,
    "Cache-Control": "no-store",
    Vary: "Cookie, Accept-Language",
  },
});
---
