---
import { t, bookingHref } from "../i18n/utils";
import type { Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="booking-banner" role="status">
  <div class="container booking-banner__inner">
    <svg
      class="booking-banner__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5.8 11.3 2 22l10.7-3.79" />
      <path d="M4 3h.01" />
      <path d="M22 8h.01" />
      <path d="M15 2h.01" />
      <path d="M22 20h.01" />
      <path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10" />
      <path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11c-.11.7-.72 1.22-1.43 1.22H17" />
      <path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98C9.52 4.9 9 5.52 9 6.23V7" />
      <path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z" />
    </svg>
    <p class="booking-banner__text">{t(locale, "Banner", "bookingLive")}</p>
    <a
      class="booking-banner__link"
      href={bookingHref(locale)}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t(locale, "Banner", "bookingCta")}
      <svg
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  </div>
</aside>

<style>
  .booking-banner {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-hairline);
  }
  .booking-banner__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    flex-wrap: wrap;
  }
  .booking-banner__icon {
    width: 18px;
    height: 18px;
    color: var(--color-green);
    flex-shrink: 0;
  }
  .booking-banner__text {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .booking-banner__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-green);
    white-space: nowrap;
    text-decoration: none;
  }
  .booking-banner__link:hover {
    color: var(--color-green-dark);
  }
  .booking-banner__link svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  @media (max-width: 640px) {
    .booking-banner__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
    }
    .booking-banner__icon {
      display: none;
    }
    .booking-banner__text {
      font-size: var(--fs-xs);
    }
    .booking-banner__link {
      font-size: var(--fs-xs);
    }
  }
</style>
