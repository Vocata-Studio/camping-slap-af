---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BookingBanner from "../components/BookingBanner.astro";
import WeatherFab from "../components/WeatherFab.astro";
import { contactUi, stripLocaleFromPath, locales, t, navLinks, localePath } from "../i18n/utils";
import type { Locale } from "../i18n/utils";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  /** Path to the page's LCP hero image — preloaded so the browser fetches it ASAP. */
  preloadImage?: string;
}

const { title, locale, description, preloadImage } = Astro.props;
const currentRoute = stripLocaleFromPath(Astro.url.pathname);
const copyUi = contactUi(locale);
const pageDescription =
  description ??
  "Camping Slap Af — rolig camping i Sejerslev på Mors, midt i den danske natur.";

const SITE_URL = "https://campingslapaf.dk";
const canonicalPath = currentRoute === "/" ? `/${locale}/` : `/${locale}${currentRoute}`;
const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const ogImage = `${SITE_URL}/CSA-OG.jpeg`;

const ogLocaleMap: Record<string, string> = {
  da: "da_DK", en: "en_US", de: "de_DE", nl: "nl_NL",
  fr: "fr_FR", es: "es_ES", it: "it_IT", sv: "sv_SE",
  nb: "nb_NO", pl: "pl_PL",
};

const localeAlternates = locales.map((l) => ({
  lang: l,
  href: currentRoute === "/" ? `${SITE_URL}/${l}/` : `${SITE_URL}/${l}${currentRoute}`,
}));

const ORG_ID = `${SITE_URL}/#organization`;
const SITE_ID = `${SITE_URL}/#website`;
const isHome = currentRoute === "/";

// Localized navigation items — handed to Google as sitelink candidates.
const navItems = navLinks.map((link) => ({
  "@type": "SiteNavigationElement",
  "name": t(locale, "Header", link.key),
  "url": `${SITE_URL}${localePath(locale, link.href)}`,
}));

// Breadcrumb trail on inner pages (Home > current page).
const breadcrumb = isHome
  ? null
  : {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t(locale, "Header", "home"),
          "item": `${SITE_URL}/${locale}/`,
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": title,
          "item": canonicalUrl,
        },
      ],
    };

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORG_ID,
      "name": "Camping Slap Af",
      "url": SITE_URL,
      "logo": `${SITE_URL}/CSA-logo-final.png`,
      "image": ogImage,
      "email": "campingslapaf@outlook.com",
      "telephone": "+4591199674",
      "sameAs": ["https://www.facebook.com/profile.php?id=61584886509520"]
    },
    {
      "@type": "WebSite",
      "@id": SITE_ID,
      "url": SITE_URL,
      "name": "Camping Slap Af",
      "inLanguage": locale,
      "publisher": { "@id": ORG_ID }
    },
    {
      "@type": ["Campground", "LodgingBusiness"],
      "@id": `${SITE_URL}/#business`,
      "name": "Camping Slap Af",
      "description": "Rolig familiecamping i Sejerslev på Mors, midt i den danske natur ved Limfjorden.",
      "url": SITE_URL,
      "parentOrganization": { "@id": ORG_ID },
      "telephone": "+4591199674",
      "email": "campingslapaf@outlook.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Kærvang 7",
        "addressLocality": "Sejerslev",
        "postalCode": "7900",
        "addressRegion": "Morsø",
        "addressCountry": "DK"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 56.930468,
        "longitude": 8.870665
      },
      "image": ogImage,
      "petsAllowed": true,
      "priceRange": "kr",
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "validThrough": "2026-10-18",
        "opens": "00:00",
        "closes": "23:59",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]
      },
      "amenityFeature": [
        {"@type": "LocationFeatureSpecification", "name": "Toiletter og baderum", "value": true},
        {"@type": "LocationFeatureSpecification", "name": "Fællesrum", "value": true},
        {"@type": "LocationFeatureSpecification", "name": "Legeplads", "value": true},
        {"@type": "LocationFeatureSpecification", "name": "Hundelegeplads", "value": true},
        {"@type": "LocationFeatureSpecification", "name": "Kiosk", "value": true},
        {"@type": "LocationFeatureSpecification", "name": "Bålplads", "value": true}
      ]
    },
    ...navItems,
    ...(breadcrumb ? [breadcrumb] : [])
  ]
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />

    <link rel="canonical" href={canonicalUrl} />
    {localeAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/da/`} />

    <meta property="og:title" content={`${title} | Camping Slap Af`} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Camping Slap Af — rolig camping i Sejerslev på Mors" />
    <meta property="og:locale" content={ogLocaleMap[locale]} />
    <meta property="og:site_name" content="Camping Slap Af" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Camping Slap Af`} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={schema}></script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preload" as="image" href="/CSA-logo-final.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Load fonts without blocking render: preload the stylesheet, then swap
        media print→all on load. `display=swap` keeps text visible meanwhile. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <title>{title} | Camping Slap Af</title>
    <slot name="head" />

    <Analytics />

    <script is:inline>
      (function () {
        var mode = "light";
        try {
          var stored = localStorage.getItem("campingslapaf.theme");
          if (stored === "dark") mode = "dark";
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", mode);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <BookingBanner locale={locale} />
    <Header locale={locale} currentRoute={currentRoute} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <WeatherFab locale={locale} />
    <div class="copy-toast" id="contact-copy-toast" aria-live="polite" aria-atomic="true"></div>
    <script define:vars={{ copyUi }}>
      const toast = document.getElementById("contact-copy-toast");
      let toastTimer;

      const canUseNativePhoneLink = () =>
        window.matchMedia("(hover: none) and (pointer: coarse)").matches;

      const fallbackCopy = async (value) => {
        const input = document.createElement("textarea");
        input.value = value;
        input.setAttribute("readonly", "");
        input.style.position = "absolute";
        input.style.opacity = "0";
        document.body.append(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      };

      const copyValue = async (value) => {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
          return;
        }
        await fallbackCopy(value);
      };

      const showToast = (message) => {
        if (!toast) return;
        toast.textContent = message || copyUi.copied;
        toast.classList.add("copy-toast--visible");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toast.classList.remove("copy-toast--visible");
        }, 2200);
      };

      const markCopied = (trigger) => {
        trigger.dataset.copied = "true";
        window.setTimeout(() => {
          if (trigger.dataset.copied === "true") {
            delete trigger.dataset.copied;
          }
        }, 1800);
      };

      document.querySelectorAll("[data-copy-value]").forEach((trigger) => {
        trigger.addEventListener("click", async (event) => {
          const shouldKeepPhoneLink =
            trigger.dataset.copyMobileCall === "true" && canUseNativePhoneLink();

          if (shouldKeepPhoneLink) return;

          event.preventDefault();

          try {
            await copyValue(trigger.dataset.copyValue || "");
            markCopied(trigger);
            showToast(trigger.dataset.copyToast || copyUi.copied);
          } catch {
            showToast(copyUi.copyFailed);
          }
        });
      });
    </script>

    <!-- Theme toggle: bound once here so every [data-theme-toggle] (mobile menu + footer) shares one handler. -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = "campingslapaf.theme";

        function syncIcons() {
          var dark = document.documentElement.getAttribute("data-theme") === "dark";
          document.querySelectorAll('[data-theme-icon="sun"]').forEach(function (el) {
            el.style.display = dark ? "block" : "none";
          });
          document.querySelectorAll('[data-theme-icon="moon"]').forEach(function (el) {
            el.style.display = dark ? "none" : "block";
          });
        }

        function apply(next) {
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
          syncIcons();
        }

        syncIcons();

        document.querySelectorAll("[data-theme-toggle]").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var current = document.documentElement.getAttribute("data-theme");
            var next = current === "dark" ? "light" : "dark";
            if (typeof document.startViewTransition === "function") {
              document.startViewTransition(function () { apply(next); });
            } else {
              apply(next);
            }
          });
        });
      })();
    </script>
    {Astro.locals.preview && <span hidden data-vocata-preview-scroll></span>}
    <script>
      import { initPreview } from "@vocata-studio/cms-client/preview";
      if (document.querySelector("[data-vocata-preview-scroll]")) initPreview();
    </script>
  </body>
</html>
